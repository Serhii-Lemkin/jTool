rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function hasInvite(groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())/items/$(groupId));
    }

    // --- Rules ---

    // 1. GLOBAL ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 2. PUBLIC PROFILES
    match /public_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && profileId == request.auth.uid;
    }

    // 3. USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (
        userId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds']) &&
         isGroupMember(request.resource.data.groupIds[request.resource.data.groupIds.size() - 1]))
      );
    }

    // 4. USER DATA
    match /user_data/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    // 5. CALENDAR EVENTS (Centralized Collection)
    match /calendar_events/{eventId} {
      function userGroupIds() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupIds;
      }

      function canReadSharedEvent() {
        return resource.data.sharedGroupIds.toSet().hasAny(userGroupIds().toSet());
      }

      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        canReadSharedEvent()
      );
      allow update: if isSignedIn() && request.auth.uid == resource.data.ownerUid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      }
    }

    // 6. GROUPS & SHARED DATA
    match /groups/{groupId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.isPrivate == false ||
        resource.data.ownerUid == request.auth.uid ||
        isGroupMember(groupId)
      );
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.isPrivate == false
      );
      allow create: if isSignedIn();
      allow update: if isGroupMember(groupId) && (resource.data.isPrivate == false || resource.data.ownerUid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /group_notifications/{notifId} {
        allow read, write, delete: if isGroupMember(groupId);
        match /seen_by/{userId} {
          allow read: if isGroupMember(groupId);
          allow write: if isGroupMember(groupId) && userId == request.auth.uid;
        }
      }

      match /join_requests/{userId} {
        allow read: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
      }

      match /members/{userId} {
        allow read: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
        allow create: if isSignedIn() && (
          (request.auth.uid == userId && (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid || hasInvite(groupId))) ||
          (isGroupMember(groupId) && exists(/databases/$(database)/documents/groups/$(groupId)/join_requests/$(userId)))
        );
        allow delete: if isSignedIn() && (request.auth.uid == userId || isGroupMember(groupId));
      }

      match /{allSubcollections=**} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // 7. INVITES
    match /invites/{email} {
      allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      match /items/{inviteId} {
        allow create: if isSignedIn();
        allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      }
    }

    // 8. SUPPORT REQUESTS
    match /support_requests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 9. APP CONFIG
    match /app_options/{optionId} {
      allow read: if isSignedIn();
    }
  }
}
