rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function hasInvite(groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())/items/$(groupId));
    }

    // --- Rules ---

    // 1. GLOBAL ADMIN OVERRIDE
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 2. PUBLIC PROFILES - READABLE BY ALL SIGNED-IN USERS
    // Required for the global name cache to work with collection listeners.
    // Contains only non-sensitive data (displayName, calendarEmail).
    match /public_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && profileId == request.auth.uid;
    }

    // 3. GLOBAL METADATA
    match /metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. USERS & PRIVATE DATA
    match /users/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;

      match /work_history/{itemId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /user_data/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    // 5. GROUPS & SHARED DATA (UNSIMPLIFIED)
    match /groups/{groupId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.isPrivate == false ||
        resource.data.ownerUid == request.auth.uid ||
        isGroupMember(groupId)
      );
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.isPrivate == false ||
        isGroupMember(groupId)
      );
      allow create: if isSignedIn();
      allow update: if isGroupMember(groupId) && (resource.data.isPrivate == false || resource.data.ownerUid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /group_notifications/{notifId} {
        allow read, write, delete: if isGroupMember(groupId);
      }

      match /join_requests/{userId} {
        allow read: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
      }

      match /members/{userId} {
        allow read: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
        allow create: if isSignedIn() && (
          (request.auth.uid == userId && (exists(/databases/$(database)/documents/groups/$(groupId)) && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid || hasInvite(groupId))) ||
          (isGroupMember(groupId) && exists(/databases/$(database)/documents/groups/$(groupId)/join_requests/$(userId)))
        );
        allow delete: if isSignedIn() && (request.auth.uid == userId || isGroupMember(groupId));
      }

      // Shared sub-collections (Shopping, Notes, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // 6. INVITES
    match /invites/{email} {
      allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      match /items/{inviteId} {
        allow create: if isSignedIn();
        allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      }
    }

    // 7. CALENDAR EXTENSIONS & COMMENTS
    match /calendar_event_extensions/{eventId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.sharedGroupIds.hasAny(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupIds)
      );
      allow write: if isSignedIn(); // Restricted via app logic to owners/members

      match /comments/{commentId} {
        // Allow adding comments if you can see the event
        allow read, write: if isSignedIn();
      }
    }

    // 8. SUPPORT REQUESTS
    match /support_requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read, write: if isSignedIn() &&
          get(/databases/$(database)/documents/support_requests/$(requestId)).data.userId == request.auth.uid;
      }
    }

    // 9. OTHER COLLECTIONS
    match /app_options/{optionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && optionId == "support_data");
    }
    match /requested_languages/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}
