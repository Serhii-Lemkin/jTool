















































































































rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function hasInvite(groupId) {
      return isSignedIn() && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())/items/$(groupId));
    }

    match /{document=**} { allow read, write: if isAdmin(); }

    match /public_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && profileId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (
        userId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds']) && isGroupMember(request.resource.data.groupIds[request.resource.data.groupIds.size() - 1]))
      );
    }

    match /user_data/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;

      match /personal_notifications/{notifId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    match /groups/{groupId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isGroupMember(groupId);
      allow create: if isSignedIn();
      allow update: if isGroupMember(groupId);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /group_notifications/{notifId} {
        allow read, write, delete: if isGroupMember(groupId);
        match /seen_by/{userId} {
          allow read, write: if isGroupMember(groupId) && userId == request.auth.uid;
        }
      }

      match /join_requests/{userId} {
        allow read: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
      }

      match /members/{userId} {
        allow read: if isSignedIn() && (isGroupMember(groupId) || request.auth.uid == userId);
        allow create: if isSignedIn() && (
          (request.auth.uid == userId && (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid || hasInvite(groupId))) ||
          (isGroupMember(groupId) && exists(/databases/$(database)/documents/groups/$(groupId)/join_requests/$(userId)))
        );
        allow delete: if isSignedIn() && (request.auth.uid == userId || isGroupMember(groupId));
      }

      match /{allSubcollections=**} { allow read, write: if isGroupMember(groupId); }
    }

    match /invites/{email} {
      allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      match /items/{inviteId} {
        allow create: if isSignedIn();
        allow read, delete: if isSignedIn() && request.auth.token.email.lower() == email.lower();
      }
    }

    match /suggestions/{suggestionId} { allow read, create: if isSignedIn(); }
    match /app_options/{optionId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && optionId == 'support_data';
    }
    match /app_info/{infoId} { allow read: if isSignedIn(); }
  }
}